rs from the supplied versioned supporting seed.\"\n    },\n    {\n      \"exampleId\": \"D120-single-a\",\n      \"beforeHash\": \"80c3075c6ba5dda64a4f58824ef82374f82266971bfd53069efbade468ad086a\",\n      \"firstPass\": {\n        \"ratings\": {\n          \"cardFidelity\": {\"score\": 4, \"evidence\": \"A1 treats a sign-off as a repeated breakup warning, but A5 does not specifically incorporate B4's reassurance as new evidence.\"},\n          \"responseLogic\": {\"score\": 3, \"evidence\": \"A3 answers B2's ordinariness claim by analogy; A5 asserts words arriving in order without establishing that order or using B4's exact wording.\"},\n          \"relationship\": {\"score\": 4, \"evidence\": \"B2 explains an ordinary sign-off and B4 directly reassures A that the relationship is continuing.\"},\n          \"heightening\": {\"score\": 3, \"evidence\": \"A5 strengthens the prediction into an ordered pattern, but supplies no concrete additional step from B4.\"},\n          \"specificity\": {\"score\": 4, \"evidence\": \"A1's 'take care' message and A3's separate dinner give actors recognizable relationship details.\"},\n          \"brevityWit\": {\"score\": 3, \"evidence\": \"A5's 'familiar warning words arriving in order' summarizes the mechanism more than it demonstrates it.\"}\n        },\n        \"weightedTotal\": 71\n      },\n      \"beats\": [\n        {\"speaker\": \"A\", \"text\": \"You ended your message with 'take care.' That's how my last breakup started.\"},\n        {\"speaker\": \"B\", \"text\": \"You said you had a cold. I meant get better.\"},\n        {\"speaker\": \"A\", \"text\": \"He wanted me healthy before he left too. Less guilt.\"},\n        {\"speaker\": \"B\", \"text\": \"I'll bring you soup tonight.\"},\n        {\"speaker\": \"A\", \"text\": \"So we're at the final kindness. Will it be in a container you don't need back?\"}\n      ],\n      \"decision\": \"revised\",\n      \"mechanism\": \"D120 makes A absorb each new emotional detail i