{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalemailted.github.io/improv-card-game/schemas/card.schema.json",
  "title": "Imprompt Card",
  "description": "Machine-readable schema for a published or in-development Imprompt Stance or Drive card.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "type",
    "packId",
    "contentVersion",
    "status",
    "title",
    "instruction",
    "category",
    "categoryId",
    "subtheme",
    "subthemeId",
    "difficulty",
    "intensity",
    "tone",
    "orientation",
    "coachRoles",
    "motifs",
    "recommendedModes"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[SD][0-9]{2,3}$" },
    "type": { "type": "string", "enum": ["stance", "drive"] },
    "packId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "contentVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "type": "string", "enum": ["draft", "review", "playtest", "published", "retired"] },
    "title": { "type": "string", "minLength": 2, "maxLength": 60 },
    "instruction": { "type": "string", "minLength": 8, "maxLength": 240 },
    "category": { "type": "string", "minLength": 2, "maxLength": 48 },
    "categoryId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "subtheme": { "type": "string", "minLength": 2, "maxLength": 64 },
    "subthemeId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "difficulty": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
    "intensity": { "type": "string", "enum": ["low", "medium", "high"] },
    "tone": { "type": "string", "enum": ["grounded", "heightened", "absurd", "flexible"] },
    "orientation": {
      "type": "string",
      "enum": ["toward-partner", "against-partner", "away-from-partner", "self-focused", "world-focused"]
    },
    "coachRoles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "motifs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "recommendedModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["open", "mirror", "paired"] }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "stance" } } },
      "then": { "properties": { "id": { "pattern": "^S[0-9]{2,3}$" } } }
    },
    {
      "if": { "properties": { "type": { "const": "drive" } } },
      "then": { "properties": { "id": { "pattern": "^D[0-9]{2,3}$" } } }
    }
  ]
}
