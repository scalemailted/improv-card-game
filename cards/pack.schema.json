{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalemailted.github.io/improv-card-game/schemas/pack.schema.json",
  "title": "Imprompt Card Pack",
  "description": "Schema for an official Imprompt card pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "version",
    "status",
    "sequence",
    "remainingPublicationGates",
    "editorialReviewVersion",
    "publicationWave",
    "publicationStage",
    "description",
    "stances",
    "drives"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "drafting",
        "playtest",
        "published",
        "retired"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 360
    },
    "stances": {
      "type": "array",
      "items": {
        "$ref": "card.schema.json"
      }
    },
    "drives": {
      "type": "array",
      "items": {
        "$ref": "card.schema.json"
      }
    },
    "publicationStage": {
      "type": "string",
      "enum": [
        "published",
        "editorial-consolidated",
        "live-validation",
        "publication-candidate",
        "retired"
      ]
    },
    "publicationWave": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "editorialReviewVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "remainingPublicationGates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 64
      }
    }
  }
}
